# Gemini API Key (Server-side runtime AI calls)
GEMINI_API_KEY=

# GitHub Personal Access Token (Optional local dev fallback)
GITHUB_TOKEN=

# GitHub App Credentials (Optional for Connect GitHub user authentication)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Dedicated Server Session Encryption Secret (Required when Connect GitHub is enabled - 32+ character random string)
SESSION_SECRET=
